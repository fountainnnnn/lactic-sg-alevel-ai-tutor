# secrets — NEVER commit (real API keys, service-role key, access token)
.env
.env.local

# corpus is 16GB of third-party school/exam PDFs (school_prelim copyright) with
# files >100MB that GitHub rejects — re-downloadable via the ingest scripts.
corpus/

# vault/ and grail_*.json are derived from licensed exam material and are kept
# private; the ingest pipeline rebuilds them from a corpus you have rights to.
vault/
grail_*.json

# build / cache / machine-specific junk (regenerable, not project content)
__pycache__/
*.pyc
.venv/
venv/
node_modules/
.deno/
app/.expo/
app/dist/

# misc
*.log
.DS_Store
_test_jwt.txt

# supabase CLI working state
supabase/.temp/

# ad-hoc dev scratch — not project content
*.err
ab_test.mjs
test_preflight.mjs
smoke_*.mjs
drop_list.txt
figma_shots/

# on-device test artifacts (screenshots, UI dumps, build logs) — repo root only
/*.png
/build_log.txt
/LoopTest.java
/ui*.xml
/u.xml
