# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=        # ingest only — never ship to app
SUPABASE_ANON_KEY=                # for the app

# OpenRouter — single key fronts all generation models (auto provider failover)
OPENROUTER_API_KEY=               # https://openrouter.ai/keys

# Voyage AI (voyage-3.5-lite embeddings)
VOYAGE_API_KEY=                   # https://dashboard.voyageai.com

# Model slugs (override to A/B without redeploy). Keep in sync with the
# deployed Supabase Edge Function secrets. Production tier = paid Gemini.
MODEL_FAST=google/gemini-2.5-flash-lite        # fast paths, classify, rerank, quick answers
MODEL_DEEP=google/gemini-2.5-flash             # reasoning, derivations, deep explanations
MODEL_ESCALATE=google/gemini-2.5-pro           # explicit "I'm stuck" (~2% of turns)
MODEL_VISION=google/gemini-2.5-flash           # OCR (accuracy matters — not flash-lite)
MODEL_ENRICH=google/gemini-2.5-flash-lite      # ingest-time enrichment
MODEL_FREE=deepseek/deepseek-v3.2              # free + Lite tiers (cheaper than Gemini)
MODEL_OVERFLOW=deepseek/deepseek-v3.2          # budget-degraded fallback (free model)
MODEL_REASONING=deepseek/deepseek-v3.2         # Plus+ "Lactic Reasoning" toggle, run with thinking ON (best at math, cheaper than Gemini)

# Limits & budget (all optional — sensible defaults in code).
# DAILY allowance is a per-user TOKEN budget (prompt+completion, rolling 24h),
# NOT a turn count: a casual chat (~4k tok) draws far less than a retrieval-heavy
# solve (~14k tok). Sized from real usage (~7.5k tok/turn): Free ≈40 turns,
# Lite ≈65, Plus ≈130, Max ≈325 turns-equivalent. Ladder: Lite ≈1.6× Free,
# Plus = 2× Lite, Max = 5× Lite. Keep in sync with plans.dart (paywall labels).
FREE_TOKENS_PER_DAY=300000
LITE_TOKENS_PER_DAY=490000
PLUS_TOKENS_PER_DAY=980000
MAX_TOKENS_PER_DAY=2450000
ANSWER_MAX_TOKENS=4000           # completion cap on the prose answer (~4x worst-case multi-part answer; stops runaway tails, never truncates real answers)
TURNS_PER_MINUTE=8                # anti-burst throttle (count, all signed-in tiers)
MONTHLY_BUDGET_USD=40            # global circuit-breaker -> degrade to MODEL_OVERFLOW
# Per-user MONTHLY cost guardrail (USD) so a paying user can never out-cost their plan.
# soft -> degrade THAT user to the cheap model; hard -> stop paid turns till month resets.
# Both sit below each tier's net revenue (after store cut, even on the annual plan).
PLUS_MONTH_COST_SOFT_USD=4       # Plus: degrade to cheap model past this MTD spend
PLUS_MONTH_COST_HARD_USD=6       # Plus: hard stop past this (net annual rev ~$7.28)
MAX_MONTH_COST_SOFT_USD=8.5      # Max: degrade to cheap model past this MTD spend
MAX_MONTH_COST_HARD_USD=12       # Max: hard stop past this (net annual rev ~$15.67)
LITE_MONTH_COST_HARD_USD=3.8     # Lite: hard stop past this (net annual rev ~$4.14; soft==hard, already cheap model)
LITE_PHOTOS_PER_DAY=2            # Lite: photo-solve taste per day (Plus+ unlimited); Free gets none
ANON_TURNS_PER_DAY=5             # anonymous taste (count) per device
ANON_TURNS_PER_IP=25            # anonymous taste (count) per IP
